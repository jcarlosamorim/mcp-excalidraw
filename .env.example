# Copy to .env and adjust. Every value below is optional — the defaults work.

# --- Canvas server (dist/server.js) ---
PORT=3000
HOST=127.0.0.1                 # keep 127.0.0.1 unless you know why; the API has no auth

# --- MCP server (dist/index.js) ---
EXPRESS_SERVER_URL=http://127.0.0.1:3000
ENABLE_CANVAS_SYNC=true

# --- Where the canvas keeps your data ---
# CANVAS_DATA_DIR=~/.excalidraw-canvas          # scene state + projects catalog (SQLite)
# EXCALIDRAW_PROJECTS_DIR=~/Documents/Excalidraw # .excalidraw files — the source of truth
# EXCALIDRAW_LOGOS_DIR=~/.excalidraw-canvas/logos # the folder IS the logo library
# EXCALIDRAW_DOWNLOADS_DIR=~/Downloads          # scanned to rescue stray .excalidraw files
# EXCALIDRAW_EXPORT_DIR=~/Downloads             # where export_to_image writes

# --- Diagram agent (optional; without it the agent bar is simply inert) ---
# Any OpenAI-compatible endpoint: LM Studio, Ollama, vLLM, OpenAI, OpenRouter...
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=google/gemma-4-26b-a4b
# LLM_API_KEY=                                  # only for remote providers
# LLM_NO_SCHEMA=1                               # 1 = plain-text mode. Required for local
                                                # models that degenerate under constrained
                                                # decoding (see AGENT.md).

# --- Logging ---
# LOG_LEVEL=info
# LOG_FILE_PATH=
# DEBUG=false
